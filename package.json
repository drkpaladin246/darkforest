{
  "name": "darkforest",
  "productName": "Pomodoro Forest",
  "version": "1.0.0",
  "description": "A focus timer that grows a low-poly 3D forest, one Pomodoro at a time.",
  "main": "src/main.js",
  "author": "Kadir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/drkpaladin246/darkforest.git"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "prestart": "node scripts/ensure-electron.js",
    "start": "electron .",
    "icons": "node scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win",
    "test": "node --test test/core.test.mjs",
    "dist:mac-intel": "electron-builder --mac --x64"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "electron": "39.8.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.pomodoroforest.app",
    "productName": "Pomodoro Forest",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray*.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Pomodoro Forest"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Pomodoro Forest"
    },
    "afterPack": "scripts/after-pack.js"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  }
}
